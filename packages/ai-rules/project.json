{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "ai-rules",
  "projectType": "library",
  "sourceRoot": "packages/ai-rules/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/**/*", "sharedGlobals", "!{workspaceRoot}/package-lock.json"],
      "options": {
        "command": "tsx scripts/build.ts",
        "cwd": "{projectRoot}",
        "outputPath": "dist/packages/ai-rules"
      },
      "outputs": ["{options.outputPath}"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["packages/ai-rules/**/*.[jt]s?(x)"],
        "maxWarnings": 0
      },
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/vitest:test",
      "inputs": [
        "{projectRoot}/**/*",
        "sharedGlobals",
        "^production",
        "{workspaceRoot}/vitest.preset.ts",
        "!{workspaceRoot}/package-lock.json"
      ],
      "options": {
        "configFile": "packages/ai-rules/vitest.config.ts"
      }
    }
  }
}
