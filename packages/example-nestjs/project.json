{
  "name": "example-nestjs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/example-nestjs/src",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"packages/example-nestjs/**/*.[jt]s\" --max-warnings 0"
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "example-nestjs:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "example-nestjs:build:development"
        },
        "production": {
          "buildTarget": "example-nestjs:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "packages/example-nestjs/vitest.config.ts"
      }
    }
  }
}
