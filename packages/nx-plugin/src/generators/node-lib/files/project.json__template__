{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "<%= projectName %>",
  "projectType": "library",
  "sourceRoot": "packages/<%= projectName %>/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "assets": ["packages/<%= projectName %>/*.md"],
        "main": "packages/<%= projectName %>/src/index.js",
        "outputPath": "dist/packages/<%= projectName %>",
        "tsConfig": "packages/<%= projectName %>/tsconfig.lib.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"<%= projectRoot %>/**/*.[jt]s?(x)\" --max-warnings 0"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "packages/<%= projectName %>/vitest.config.ts"
      }
    }
  }
}
